# Copy to .env.local for local development. On Vercel, add these in Project Settings -> Environment Variables.
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=use-a-long-unique-password
# At least 32 random characters:  python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# Added automatically when you connect the storage from the Vercel dashboard / `vercel env pull`:
# KV_REST_API_URL=            (or UPSTASH_REDIS_REST_URL)
# KV_REST_API_TOKEN=          (or UPSTASH_REDIS_REST_TOKEN)
# BLOB_STORE_ID=
